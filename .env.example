# ---------- Google ----------
# Path to the service account key JSON downloaded from Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json

# Each store's daily sales sheet (ID = the long string in the URL between /d/ and /edit).
# The bot finds the day's "PHONE REPAIR PRO" table by its date, in whichever tab it is.
BELLFORT_SPREADSHEET_ID=
SHAVER_SPREADSHEET_ID=

# Monthly target sheet and the tab the bot fills in
TARGET_SPREADSHEET_ID=
TARGET_TAB=data entry
# Title row of each store's table in that tab
BELLFORT_TARGET_TITLE=PHONE REPAIR STORE
SHAVER_TARGET_TITLE=SHAVER STORE

# ---------- WhatsApp ----------
# Exact group name, or its ID (e.g. 1203630xxxxxxxx@g.us,
# or a channel ID ending in @newsletter). Run `npm run list-chats` to find IDs.
WHATSAPP_TARGET=

# Browser used by WhatsApp Web and for screenshots. Leave blank to use Puppeteer's bundled Chromium.
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ---------- Schedule ----------
# Cron format: minute hour day month weekday
# Every hour on the hour from 12 PM to 6 PM store time
CRON_SCHEDULE=0 12-18 * * *
# Timezone for the schedule, for deciding which day is "today", and for the caption
TIMEZONE=America/Chicago
# Runs before this hour report the previous day (so the 12 AM run sends the finished day)
PREVIOUS_DAY_BEFORE_HOUR=0
# Run once immediately when the bot starts (true/false)
RUN_ON_START=false