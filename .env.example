# ---------- Google ----------
# Path to the service account key JSON downloaded from Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json

# Each store's daily sales sheet (ID = the long string in the URL between /d/ and /edit).
# The bot finds the day's "PHONE REPAIR PRO" table by its date, in whichever tab it is.
BELLFORT_SPREADSHEET_ID=
SHAVER_SPREADSHEET_ID=

# Monthly target sheet. The bot fills today's figures into its HOURLY tab
# and sends a screenshot of that report (columns A to M).
TARGET_SPREADSHEET_ID=
HOURLY_TAB=HOURLY
# Labels of each store's row in the HOURLY tab
BELLFORT_HOURLY_LABEL=BELLFORT AVE
SHAVER_HOURLY_LABEL=SHAVER ST

# ---------- WhatsApp ----------
# Number of the WhatsApp account that should be linked (country code, no +).
# Not used to log in (that's the QR code); the bot refuses to send if a different account is linked.
WHATSAPP_SENDER=
# Where messages go: a phone number (becomes <number>@c.us), a group ID ending in @g.us,
# or an exact group name. Several targets: separate with commas. Run `npm run list-chats` to find group IDs.
WHATSAPP_TARGET=

# On a server: serve the WhatsApp QR page on 127.0.0.1:<port> (open it through an SSH tunnel). Leave blank on a PC.
QR_PORT=

# Browser used by WhatsApp Web and for screenshots. Leave blank to use Puppeteer's bundled Chromium.
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ---------- Schedule ----------
# Cron format: minute hour day month weekday
# Every hour on the hour from 12 PM to 7 PM store time (caption "Till 12 PM" ... "Till 7 PM")
CRON_SCHEDULE=0 12-19 * * *
# Timezone for the schedule, for deciding which day is "today", and for the caption
TIMEZONE=America/Chicago
# Runs before this hour report the previous day (so the 12 AM run sends the finished day)
PREVIOUS_DAY_BEFORE_HOUR=0
# Run once immediately when the bot starts (true/false)
RUN_ON_START=false